datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMERACIONES DEL NEGOCIO
// ==========================================

enum RolUsuario {
  ADMIN
  CAJERO
}

enum FormatoImpresion {
  TIRILLA
  MEDIA_CARTA
  CARTA
}

enum TipoProducto {
  VENTA
  ALQUILER
}

enum CategoriaProducto {
  VENTA
  ALQUILER
}

enum UnidadMora {
  HORA
  DIA
}

enum EstadoPrenda {
  DISPONIBLE
  ALQUILADO
  SEPARADO
  EN_ARREGLO
  INACTIVO
}

enum TipoOperacion {
  VENTA
  ALQUILER
  SEPARE
  ARREGLO
  MIXTO
}

enum EstadoFactura {
  ACTIVA
  EN_PROCESO
  ACTIVA_ALQUILADA
  EN_MORA
  CERRADA
}

enum MetodoPago {
  EFECTIVO
  NEQUI
  BANCOLOMBIA
  LLAVE
  DAVIPLATA
  TRANSFERENCIA
  CONSIGNACION
}

enum EstadoTurno {
  ABIERTO
  CERRADO
}

enum TipoCierre {
  DIARIO
  CONSOLIDADO_MENSUAL
}

// ==========================================
// MODELOS RELACIONALES
// ==========================================

model User {
  id            String           @id @default(cuid())
  username      String           @unique
  nombre        String
  passwordHash  String
  rol           RolUsuario       @default(CAJERO)
  activo        Boolean          @default(true)
  fechaCreacion DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  facturas      Factura[]
  abonos        Abono[]
  turnos        TurnoCaja[]
  cierres       CierreCaja[]
  auditorias    AuditoriaSesion[]

  @@map("usuarios")
}

model AuditoriaSesion {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accion     String   // LOGIN, LOGOUT, INTENTO_FALLIDO
  detalles   String?
  ip         String?
  userAgent  String?
  fechaHora  DateTime @default(now())

  @@index([userId])
  @@map("auditorias_sesion")
}

model ConfiguracionEmpresa {
  id                      String           @id @default(cuid())
  nombreTienda            String           @default("LLANOMIO")
  nombreComercial         String           @default("LLANOMIO")
  eslogan                 String?          @default("Trajes Típicos, Disfraces y Sastrería")
  nit                     String           @unique @default("900.123.456-7")
  regimenFiscal           String?          @default("No Responsable de IVA")
  direccion               String           @default("Calle 15 # 22-30, Barrio Siete de Agosto")
  ciudad                  String?          @default("Villavicencio, Meta")
  telefono                String           @default("310 123 4567")
  email                   String?          @default("contacto@llanomio.com")
  logoUrl                 String?          // Base64 Data URL o ruta local
  encabezadoFactura       String?          // Subtítulo o lema de encabezado
  mostrarVendedorFactura  Boolean          @default(true)
  politicasFactura        String?          // Términos, condiciones, requisitos y normas de alquiler/venta
  piePaginaFactura        String?          // Agradecimiento o pie institucional
  formatoPredeterminado   String           @default("MEDIA_CARTA") // TIRILLA | MEDIA_CARTA | CARTA
  formatoImpresionDefault FormatoImpresion @default(MEDIA_CARTA)
  rutaCarpetaRespaldo     String           @default("C:\\POS_LLANOMIO_BACKUPS")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@map("configuracion_empresa")
}

model Cliente {
  id                    String    @id @default(cuid())
  documento             String    @unique
  nombre                String
  telefono              String?
  email                 String?
  direccion             String?
  notas                 String?

  // Cumplimiento Tributario DIAN / Facturación Electrónica
  esResponsableIVA      Boolean   @default(false)
  tipoIdentificacion    String    @default("CC") // "CC", "NIT", "CE", "PASAPORTE", "TI", "CONSUMIDOR_FINAL"
  digitoVerificacion    String?   // Ej: "5"
  razonSocial           String?   // Razón Social / Nombre Legal del RUT
  responsabilidadFiscal String    @default("O-99") // "O-99", "O-48", "O-13", "O-15", "O-23", "R-99-PN"
  municipio             String    @default("Villavicencio - Meta")
  codigoDaneMunicipio   String    @default("50001")

  fechaCreacion         DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  facturas              Factura[]

  @@index([nombre])
  @@index([telefono])
  @@index([esResponsableIVA])
  @@map("clientes")
}

model Producto {
  id                     String       @id @default(cuid())
  codigo                 String       @unique
  nombre                 String
  tipo                   TipoProducto @default(ALQUILER)
  categoria              String       @default("General")
  talla                  String?
  color                  String?
  stockActual            Int          @default(1)
  estado                 EstadoPrenda @default(DISPONIBLE)
  estadoPrenda           EstadoPrenda @default(DISPONIBLE)
  precioBase             Float        @default(0)
  precioVenta            Float        @default(0)
  precioAlquilerBase     Float        @default(0)
  tiempoAlquilerBaseHoras Int         @default(24)
  tarifaMora             Float        @default(0)
  unidadMora             UnidadMora   @default(DIA)
  tarifaMoraPorDia       Float        @default(0)
  tarifaMoraPorHora      Float        @default(0)
  activo                 Boolean      @default(true)
  fechaCreacion          DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  detallesFactura        DetalleFactura[]

  @@index([tipo])
  @@index([estadoPrenda])
  @@index([activo])
  @@index([categoria])
  @@map("productos")
}

model Factura {
  id                     String         @id @default(cuid())
  consecutivo            Int?           @unique
  numeroFactura          String         @unique
  clienteId              String
  cliente                Cliente        @relation(fields: [clienteId], references: [id])
  usuarioCajeroId        String
  usuarioCajero          User           @relation(fields: [usuarioCajeroId], references: [id])
  turnoCajaId            String?
  turnoCaja              TurnoCaja?     @relation(fields: [turnoCajaId], references: [id])
  tipoOperacion          TipoOperacion  @default(VENTA)
  estado                 EstadoFactura  @default(ACTIVA)
  fechaCreacion          DateTime       @default(now())
  fechaEntregaAlquiler   DateTime?
  fechaDevolucionPactada DateTime?
  fechaDevolucionReal    DateTime?
  subtotalProductos      Float          @default(0)
  subtotalArreglosLibres Float          @default(0)
  recargoMoraAcumulado   Float          @default(0)
  totalFactura           Float          @default(0)
  totalAbonado           Float          @default(0)
  saldoPendiente         Float          @default(0)
  notas                  String?
  updatedAt              DateTime       @updatedAt

  detalles               DetalleFactura[]
  abonos                 Abono[]

  @@index([clienteId])
  @@index([usuarioCajeroId])
  @@index([turnoCajaId])
  @@index([estado])
  @@index([fechaCreacion])
  @@index([fechaDevolucionPactada])
  @@index([saldoPendiente])
  @@map("facturas")
}

model DetalleFactura {
  id               String    @id @default(cuid())
  facturaId        String
  factura          Factura   @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  productoId       String?
  producto         Producto? @relation(fields: [productoId], references: [id])
  esServicioLibre  Boolean   @default(false)
  descripcionLibre String?
  cantidad         Int       @default(1)
  precioUnitario   Float     @default(0)
  subtotal         Float     @default(0)
  fechaCreacion    DateTime  @default(now())

  @@index([facturaId])
  @@index([productoId])
  @@map("detalles_factura")
}

model Abono {
  id                    String     @id @default(cuid())
  facturaId             String
  factura               Factura    @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  cajeroId              String
  cajero                User       @relation(fields: [cajeroId], references: [id])
  turnoCajaId           String?
  turnoCaja             TurnoCaja? @relation(fields: [turnoCajaId], references: [id])
  monto                 Float
  metodoPago            MetodoPago
  montoRecibido         Float?
  vueltasEntregadas     Float?
  referenciaComprobante String?
  notas                 String?
  fecha                 DateTime   @default(now())

  @@index([facturaId])
  @@index([cajeroId])
  @@index([turnoCajaId])
  @@index([fecha])
  @@index([metodoPago])
  @@map("abonos")
}

model TurnoCaja {
  id                  String      @id @default(cuid())
  usuarioCajeroId     String
  usuarioCajero       User        @relation(fields: [usuarioCajeroId], references: [id])
  fechaApertura       DateTime    @default(now())
  fechaCierre         DateTime?
  estado              EstadoTurno @default(ABIERTO)
  baseInicialEfectivo Float       @default(0)

  // Desglose consolidado del turno por método de pago
  totalEfectivo       Float       @default(0)
  totalNequi          Float       @default(0)
  totalBancolombia    Float       @default(0)
  totalLlave          Float       @default(0)
  totalDaviplata      Float       @default(0)
  totalTransferencia  Float       @default(0)
  totalConsignacion   Float       @default(0)
  totalRecaudado      Float       @default(0)
  diferenciaEfectivo  Float       @default(0)
  observaciones       String?

  cierreCajaId        String?
  cierreCaja          CierreCaja? @relation(fields: [cierreCajaId], references: [id])

  facturas            Factura[]
  abonos              Abono[]

  @@index([usuarioCajeroId])
  @@index([cierreCajaId])
  @@index([estado])
  @@index([fechaApertura])
  @@map("turnos_caja")
}

model CierreCaja {
  id                 String     @id @default(cuid())
  usuarioId          String
  usuario            User       @relation(fields: [usuarioId], references: [id])
  tipo               TipoCierre @default(DIARIO)
  fechaInicio        DateTime
  fechaFin           DateTime
  fechaGeneracion    DateTime   @default(now())

  // Consolidado por métodos de pago
  totalBaseInicial   Float      @default(0)
  totalEfectivo      Float      @default(0)
  totalNequi         Float      @default(0)
  totalBancolombia   Float      @default(0)
  totalLlave         Float      @default(0)
  totalDaviplata     Float      @default(0)
  totalTransferencia Float      @default(0)
  totalConsignacion  Float      @default(0)
  totalGeneral       Float      @default(0)

  // Desglose por tipo de operación
  totalVentas        Float      @default(0)
  totalAlquileres    Float      @default(0)
  totalSepares       Float      @default(0)
  totalArreglos      Float      @default(0)
  totalMoras         Float      @default(0)
  cantidadFacturas   Int        @default(0)
  observaciones      String?

  turnos             TurnoCaja[]

  @@index([usuarioId])
  @@index([fechaGeneracion])
  @@map("cierres_caja")
}

model SecuenciaFactura {
  id          String   @id @default("FACTURA_SECUENCIA")
  ultimoFolio Int      @default(1000)
  updatedAt   DateTime @updatedAt

  @@map("secuencias_factura")
}
