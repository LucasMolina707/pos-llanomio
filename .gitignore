# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/

# Production build artifacts
/build
/dist
/dist_instalador/*.zip
/dist_instalador/*.tar.gz
!/dist_instalador/.gitkeep
!/dist_instalador/INSTALADOR_POS_AUTODESCOMPRIMIBLE.bat
!/dist_instalador/LEEME_INSTRUCCIONES_INSTALACION.txt

# SQLite database local files & locks (Protect actual store data from Git overwrites)
/database/*.db
/database/*.db-journal
/database/*.db-wal
/database/*.db-shm
/database/backups_locales/*
!/database/backups_locales/.gitkeep

# Archivos de migración con datos privados
/migracion_excel/origen/*
!/migracion_excel/origen/.gitkeep
/migracion_excel/excel_fuente/*
!/migracion_excel/excel_fuente/.gitkeep
*.xlsx
*.xls

# Environment files
.env
.env*.local
!.env.example

# Debug and OS logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
*.ini

# IDE specific
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj

# Directorios temporales de compilación
/.tmp/
*.sln
*.sw?
*.tsbuildinfo
*.lnk

# Runtime portable binaries (generados por npm run preparar:instalador)
/runtime/node/*
!/runtime/node/.gitkeep

# Paquetes y salvaguardas de actualización
/dist_actualizaciones/*
!/dist_actualizaciones/.gitkeep
/actualizaciones/*
!/actualizaciones/.gitkeep
manifest_actualizacion.json
*.bak
