# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/

# Production build artifacts
/build
/dist

# SQLite database local files & locks (Protect actual store data from Git overwrites)
/database/*.db
/database/*.db-journal
/database/*.db-wal
/database/*.db-shm
/database/backups_locales/*
!/database/backups_locales/.gitkeep
!/migracion_excel/excel_fuente/.gitkeep

# Environment files
.env
.env*.local
!.env.example

# Debug and OS logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
*.ini

# IDE specific
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tsbuildinfo
